	1ns
$end

$scope module PWM11_tb $end
$var reg 1 ! clk $end
$var reg 1 " rst_n $end
$var reg 11 # duty [10:0] $end
$var wire 1 $ PWM1 $end
$var wire 1 % PWM2 $end
$var wire 1 & PWM_synch $end
$var wire 1 ' ovr_I_blank $end

$scope module iDUT $end
$var parameter 11 ( NONOVERLAP $end
$var wire 1 ) clk $end
$var wire 1 * rst_n $end
$var wire 1 + duty [10] $end
$var wire 1 , duty [9] $end
$var wire 1 - duty [8] $end
$var wire 1 . duty [7] $end
$var wire 1 / duty [6] $end
$var wire 1 0 duty [5] $end
$var wire 1 1 duty [4] $end
$var wire 1 2 duty [3] $end
$var wire 1 3 duty [2] $end
$var wire 1 4 duty [1] $end
$var wire 1 5 duty [0] $end
$var wire 1 $ PWM1 $end
$var wire 1 % PWM2 $end
$var wire 1 & PWM_synch $end
$var wire 1 ' ovr_I_blank $end
$var reg 11 6 cnt [10:0] $end
$var wire 1 7 set_PWM1 $end
$var wire 1 8 reset_PWM1 $end
$var wire 1 9 set_PWM2 $end
$var wire 1 : reset_PWM2 $end
$var reg 1 ; PWM1_reg $end
$var reg 1 < PWM2_reg $end
$upscope $end
$upscope $end
$enddefinitions $end
